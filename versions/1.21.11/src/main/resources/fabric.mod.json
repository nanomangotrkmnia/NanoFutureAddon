{
  "schemaVersion": 1,
  "id": "nanofutureaddon",
  "version": "${version}",
  "name": "NanoFutureAddon",
  "description": "An addon for Meteor Client.",
  "authors": [
    "nanomango"
  ],
  "license": "ARR",
  "contact": {
    "sources": "https://github.com/nanomangotrkmnia/NanoFutureAddon"
  },
